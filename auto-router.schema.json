{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "auto-router config",
  "type": "object",
  "properties": {
    "tiers": {
      "type": "object",
      "properties": {
        "simple": { "type": "object", "properties": { "minQuality": { "type": "number" } }, "required": ["minQuality"] },
        "medium": { "type": "object", "properties": { "minQuality": { "type": "number" } }, "required": ["minQuality"] },
        "complex": { "type": "object", "properties": { "minQuality": { "type": "number" } }, "required": ["minQuality"] }
      }
    },
    "stickiness": {
      "type": "object",
      "properties": {
        "downgradeAfter": { "type": "number" },
        "upgradeImmediate": { "type": "boolean" }
      }
    },
    "guards": {
      "type": "object",
      "properties": { "contextFitMarginTokens": { "type": "number" } }
    },
    "taskTypeModels": { "type": "object" },
    "providerFreeSet": { "type": "array", "items": { "type": "string" } },
    "windowRegistry": { "type": "object", "additionalProperties": { "type": "number" } }
  }
}
